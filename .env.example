# ── Google OAuth ─────────────────────────────────────────────────────────────
# Get from https://console.cloud.google.com → APIs & Services → Credentials
# Add "http://localhost:8000/auth/google/callback" as an Authorized Redirect URI
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:8501
# For Docker frontend container: browser-visible API host used for OAuth redirects.
BROWSER_API_BASE=http://localhost:8000

# ── LLM ──────────────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com (no credit card required)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secret_key_here_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Storage ───────────────────────────────────────────────────────────────────
CHROMA_DB_PATH=./vectorstore
DOCUMENTS_PATH=./data/documents
DATABASE_URL=sqlite:///./app.db

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
HF_TOKEN=
HF_HUB_DISABLE_XET=true

# ── RAG ───────────────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.3
CHUNK_SIZE=500
CHUNK_OVERLAP=50
PDF_INGESTION_MODE=auto
ENABLE_OCR_FALLBACK=true
ENABLE_SUMMARY_INDEX=true
ENABLE_SECTION_SUMMARIES=false
ENABLE_IMAGE_SUMMARIES=true
SUMMARY_TOP_K=3
SUMMARY_MAX_CHARS=12000
VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
VISION_MAX_IMAGES_PER_DOCUMENT=5
GROUNDING_MIN_RATIO=0.12

# ── Voice ─────────────────────────────────────────────────────────────────────
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_PORT=8501
